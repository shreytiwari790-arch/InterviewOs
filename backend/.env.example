NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas → Connect → Drivers)
MONGODB_URI=

# Long random string, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# OpenAI: resume analysis, interview generation and evaluation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: OpenAI-compatible endpoint (leave empty for api.openai.com)
OPENAI_BASE_URL=

# Frontend origin(s) allowed by CORS. Comma-separate multiple values.
# The first one is used to build password reset links.
CLIENT_URL=http://localhost:5173

# Proxies in front of the API. Local: 1. Render behind the Vercel /api rewrite: 2.
TRUST_PROXY_HOPS=1

# Used by `npm run seed` to create or update the first admin account
ADMIN_EMAIL=
ADMIN_PASSWORD=
